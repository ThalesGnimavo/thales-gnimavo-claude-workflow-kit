{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list:*)",
      "Bash(casp:*)",
      "Bash(npx @justethales/casp:*)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(git --version)",
      "Bash(claude --version)",
      "Bash(ls:*)",
      "Bash(wc:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./my-projects/**/.env)"
    ]
  }
}
